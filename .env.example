# ==============================================================================
# SentinelLab Enterprise Platform Environment Variables Template
# Copy to .env.local or .env in production. NEVER COMMIT SECRETS TO VERSION CONTROL.
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3001
WS_PORT=3002

# Database Configuration (PostgreSQL 16)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=sentinel
DATABASE_PASSWORD=CHANGE_ME_IN_PRODUCTION_MIN_32_CHARS
DATABASE_NAME=sentinel_lab
DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# Redis Cache & Nonce Store (Redis 7.x)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_MIN_32_CHARS
REDIS_DB=0

# JWT Secrets & Lifespans
JWT_ACCESS_SECRET=GENERATE_STRONG_256BIT_SECRET_CHANGE_ME
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=GENERATE_STRONG_REFRESH_SECRET_CHANGE_ME
JWT_REFRESH_EXPIRES_IN=7d

# Cryptographic Keys (Base64 Encoded 256-bit keys)
CRYPTO_MASTER_KEY=GENERATE_BASE64_32_BYTES_KEY_CHANGE_ME
CRYPTO_SIGNING_KEY=GENERATE_BASE64_32_BYTES_KEY_CHANGE_ME

# Rate Limiting & Throttling
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Remote Support & Watermarking
REMOTE_SUPPORT_SESSION_TTL_SECONDS=3600
WATERMARK_ENABLED=true

# Storage & Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_BYTES=10485760 # 10MB
